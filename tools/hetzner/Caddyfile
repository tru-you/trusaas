# TruSaaS — Hetzner Caddyfile (Reverse Proxy & Auto-SSL)

# 1. Market Scraper API
scraper.tru-saas.com {
    reverse_proxy 127.0.0.1:4300
    encode gzip zstd
}

# 2. TruFlow Premium (DMS)
premium.tru-saas.com {
    reverse_proxy 127.0.0.1:3003
    encode gzip zstd
    request_body {
        max_size 50MB
    }
}

stage-premium.tru-saas.com {
    reverse_proxy 127.0.0.1:3003
    encode gzip zstd
    request_body {
        max_size 50MB
    }
}

