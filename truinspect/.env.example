# DeepSeek (optional — falls back to mock analysis)
DEEPSEEK_API_KEY=

# Hosts inject PORT (Render free tier). Local default 3000.
PORT=3000
NODE_ENV=development

# LOCAL_MODE=1 stores inventory on disk (fine for pilot free tier).
# LOCAL_MODE=0 requires Google/Firebase credentials for multi-device cloud.
LOCAL_MODE=1

# Firebase project (same as TruFlow Premium)
PROJECT_ID=gen-lang-client-0151924955
FIREBASE_PROJECT_ID=gen-lang-client-0151924955
AUTOLENS_DB_ID=ai-studio-autolenspro-7d4757ec-a059-4566-98db-d15a4840f4ec

# TruFlow DMS base URL used by Export to DMS
# Local Premium: http://localhost:3001
# Local Lite:    http://localhost:3002
# Prod Premium:  https://trusaas-premium.onrender.com
# Prod Lite:     https://trusaas-flow.onrender.com
TRUFLOW_DMS_URL=http://localhost:3001

# Headless render worker(s) (trusaas-crm-scraper, from the TruCRM repo:
# `npm run worker:dev` / `node dist/scrape-worker.cjs`). When set, every
# scraper page fetch routes through Chromium here — required for JS-rendered
# dealer sites (WeBuyCars, Bidvest McCarthy, etc.). Unset = plain HTTP.
#
# Scaling: each worker process serializes its own renders, so run several
# instances (PORT=10010 npm run worker:dev, PORT=10011 npm run worker:dev,
# ...) and list them below — requests are round-robined and fail over to the
# next worker on error. ~1 worker per 2 GB of memory.
SCRAPER_SERVICE_URLS=http://localhost:10010,http://localhost:10011
# SCRAPER_SERVICE_URL=http://localhost:10010
