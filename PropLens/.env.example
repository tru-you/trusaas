# DeepSeek (optional — falls back to mock analysis)
DEEPSEEK_API_KEY=

# Hosts inject PORT (Render free tier). Local default 3000.
PORT=3000
NODE_ENV=development

# LOCAL_MODE=1 stores inventory on disk (fine for pilot free tier).
# LOCAL_MODE=0 requires Google/Firebase credentials for multi-device cloud.
LOCAL_MODE=1

# Firebase project (same as TruFlow Premium)
PROJECT_ID=gen-lang-client-0151924955
FIREBASE_PROJECT_ID=gen-lang-client-0151924955
AUTOLENS_DB_ID=ai-studio-autolenspro-7d4757ec-a059-4566-98db-d15a4840f4ec

# FlowPMS (the master code authority) — where agency codes + slugs live.
# Every device verifies its access code here and exports captures here.
# TRUFLOW_DMS_URL is accepted as an alias for FLOWPMS_URL.
# Local FlowPMS: http://localhost:3001
FLOWPMS_URL=http://localhost:3001

# Shared secret for service-to-service calls to FlowPMS (login verify + photo
# push). MUST match FLOWPMS_SYNC_KEY on the FlowPMS server. Without it, codes
# issued in FlowPMS are refused here and this app falls back to local codes.
# TRUFLOW_SYNC_KEY is accepted as an alias.
FLOWPMS_SYNC_KEY=
