# TruRadar (packages/tru-arbitrage) — vehicle sourcing radar
# Standalone — no TruFlow/Flow coupling. The radar surfaces BUY-side market
# opportunities only. The dealer's own stock lives in TruFlow (Flow owns that
# surface: Stock-needing-action panel, price checker, TruOrbit 360).
PORT=4500

# Auth — dealer JWT layer (REQUIRED in production; tokens are forgeable without it)
JWT_SECRET=
DEMO_ENABLED=1

# Imagin8 / TransUnion catalogue refresh (`npm run catalogue:refresh`) — flat-fee
# retainer, NOT used at request time. Refreshes per-variant production year ranges
# into data/tu-years.json (committed). UI reads the local file only.
IMAGIN8_API_KEY=
IMAGIN8_CUSTOMER_ID=
IMAGIN8_APP_NAME=Flow

# Scraper year band — widen classifieds SERPs a year each side of the model year
# (dealer habit so a thin exact-year sample can't starve the comps). 0 = exact only.
SCRAPER_YEAR_TOLERANCE=1

# Classifieds ingestion (Cloudflare bypass on Cars.co.za / AutoTrader)
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=tds2

# AI Normalization fallback
GEMINI_API_KEY=

# Arbitrage margins & thresholds
MIN_ARBITRAGE_MARGIN=10000

# Dynamic recon — pct × market retail, clamped to [floor, cap]
RECON_PCT=0.03
RECON_FLOOR=5000
RECON_CAP=30000

STALE_FLOORPLAN_DAYS=40

# Valuation confidence gate — alerts below this floor never fire
CONFIDENCE_FLOOR=0.6

SCRAPER_CACHE_TTL_MS=900000
