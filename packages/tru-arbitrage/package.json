{
  "name": "@trusaas/tru-radar",
  "version": "1.0.0",
  "private": true,
  "description": "TruRadar — standalone vehicle sourcing radar: confidence-gated deal discovery across SA classifieds and dealer sites, priced against live market comps.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.cjs",
    "test": "tsx tests/arbitrage.test.ts",
    "scan:cli": "tsx src/index.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs"

  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
