# FlowPMS — the master. This is where agency codes + slugs live.
# Hosts inject PORT (Render free tier). Local default 3000.
PORT=3000

# Data persistence directory (defaults to ./data)
# DATA_DIR=

# REQUIRED — shared secret for the property suite. Satellites (PropLens,
# PropInspect) present it as `x-tru-sync-key` when verifying codes against
# this server and when pushing captures here. MUST be the SAME value on
# FlowPMS, PropLens and PropInspect. Unset = satellites cannot verify codes
# and /api/sync/push-photos refuses pushes.
FLOWPMS_SYNC_KEY=

# Optional — force the principal (agency) access code on every boot.
# Printed once to the console on first boot if unset.
# FLOWPMS_ACCESS_CODE=

# Optional — set the TruSaaS master login (role admin, no agency) used by the
# Master console to create agencies.
# FLOWPMS_MASTER_CODE=

# DeepSeek API key for AI inspection write-ups
DEEPSEEK_API_KEY=

# TURN server for NAT traversal (optional)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
