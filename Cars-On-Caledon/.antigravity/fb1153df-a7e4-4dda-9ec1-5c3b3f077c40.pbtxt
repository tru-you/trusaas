to: \'text-brand-gold\'\n  },\n\n  // 5. App.tsx branding, buttons and badges\n  {\n    file: \'src/App.tsx\',\n    from: \'text-accent-crimson\',\n    to: \'text-brand-gold\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'bg-accent-crimson\',\n    to: \'bg-brand-gold\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'hover:bg-accent-crimson-deep\',\n    to: \'hover:bg-brand-blue-deep\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'shadow-accent-crimson/20\',\n    to: \'shadow-brand-blue/20\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'hover:border-accent-crimson/50\',\n    to: \'hover:border-brand-gold/50\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'border-accent-crimson/20\',\n    to: \'border-brand-gold/20\'\n  },\n  {\n    file: \'src/App.tsx\',\n    from: \'bg-accent-crimson/10\',\n    to: \'bg-brand-blue/10\'\n  },\n\n  // 6. FinanceCalculator colors\n  {\n    file: \'src/components/FinanceCalculator.tsx\',\n    from: \'text-accent-crimson\',\n    to: \'text-brand-gold\'\n  },\n  {\n    file: \'src/components/FinanceCalculator.tsx\',\n    from: \'bg-accent-crimson\',\n    to: \'bg-brand-blue\'\n  },\n  {\n    file: \'src/components/FinanceCalculator.tsx\',\n    from: \'hover:bg-accent-crimson-deep\',\n    to: \'hover:bg-brand-blue-deep\'\n  },\n  {\n    file: \'src/components/FinanceCalculator.tsx\',\n    from: \'bg-accent-crimson/10\',\n    to: \'bg-brand-blue/10\'\n  },\n  {\n    file: \'src/components/FinanceCalculator.tsx\',\n    from: \'accent-accent-crimson\',\n    to: \'accent-brand-blue\'\n  },\n\n  // 7. TradeInForm colors\n  {\n    file: \'src/components/TradeInForm.tsx\',\n    from: \'text-accent-crimson\',\n    to: \'text-brand-gold\'\n  },\n  {\n    file: \'src/components/TradeInForm.tsx\',\n    from: \'bg-accent-crimson\',\n    to: \'bg-brand-blue\'\n  },\n  {\n    file: \'src/components/TradeInForm.tsx\',\n    from: \'hover:bg-accent-crimson-deep\',\n    to: \'hover:bg-brand-blue-deep\'\n  },\n  {\n    file: \'src/components/TradeInForm.tsx\',\n    from: \'bg-accent-crimson/5\',\n    to: \'bg-brand-blue/5\'\n  },\n  {\n    file: \'src/components/TradeInForm.tsx\',\n    from: \'accent-accent-crimson\',\n    to: \'accent-brand-blue\'\n  },\n\n  // 8. VehicleModal colors\n  {\n    file: \'src/components/VehicleModal.tsx\',\n    from: \'text-accent-crimson\',\n    to: \'text-brand-gold\'\n  },\n  {\n    file: \'src/components/VehicleModal.tsx\',\n    from: \'border-accent-crimson\',\n    to: \'border-brand-gold\'\n  },\n  {\n    file: \'src/components/VehicleModal.tsx\',\n    from: \'accent-accent-crimson\',\n    to: \'accent-brand-blue\'\n  }\n];\n\n// Perform generic global replacements on remaining instances\nconst globalReplacements = [\n  { from: /accent-crimson-deep/g, to: \'brand-blue-deep\' },\n  { from: /accent-crimson/g, to: \'brand-blue\' },\n  { from: /gold/g, to: \'brand-gold\' } // This will help capture standard gold classes\n];\n\nfilesToReplace.forEach((filename) => {\n  const filePath = path.join(__dirname, filename);\n  if (!fs.existsSync(filePath)) {\n    console.log(`File not found: ${filename}`);\n    return;\n    }\n\n  let content = fs.readFileSync(filePath, \'utf8\');\n  let originalContent = content;\n\n  // 1. File specific replacements\n  replacements.forEach((rep) => {\n    if (rep.file === filename) {\n      content = content.replace(rep.from, rep.to);\n    }\n  });\n\n  // 2. Global cleanups\n  globalReplacements.forEach((rep) => {\n    content = content.replace(rep.from, rep.to);\n  });\n\n  if (content !== originalContent) {\n    fs.writeFileSync(filePath, content, \'utf8\');\n    console.log(`Successfully updated: ${filename}`);\n  } else {\n    console.log(`No changes made to: ${filename}`);\n  }\n});\n"
