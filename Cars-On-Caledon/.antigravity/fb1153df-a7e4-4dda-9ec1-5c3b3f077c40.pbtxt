ith Blue stitching\', \'BMW Professional Navigation System\', \'Harman Kardon Sound System\', \'19-inch Double-Spoke M Alloys\', \'M Dynamic Mode (MDM)\', \'Carbon Fibre Interior Trims\']\n  },\n  {\n    id: \'audi-rs3-sportback-2019\',\n    yr: 2019,\n    make: \'Audi\',\n    name: \'RS3 Sportback\',\n    variant: \'Quattro \302\267 Sports Exhaust\',\n    body: \'Hatchback\',\n    perf: true,\n    km: 58500,\n    tr: \'S-Tronic\',\n    fuel: \'Petrol\',\n    price: 549900,\n    tag: \'5-Cylinder Legend\',\n    hot: false,\n    img: \'https://images.unsplash.com/photo-1502877338535-766e1452684a?auto=format&fit=crop&w=1000&q=80\',\n    gallery: [\n      \'https://images.unsplash.com/photo-1502877338535-766e1452684a?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1603584173870-7f23fdae1b7a?auto=format&fit=crop&w=1000&q=80\'\n    ],\n    engine: \'2.5L 5-Cylinder Turbocharged TFSI\',\n    power: \'294 kW @ 5850 rpm / 480 Nm @ 1700 rpm\',\n    owners: 2,\n    color: \'Nardo Grey\',\n    history: \'Full franchise service history with Audi\',\n    grade: \'A+\',\n    features: [\'RS Sports Exhaust System\', \'Virtual Cockpit with RS Displays\', \'Bang & Olufsen Premium Audio\', \'Panoramic Sunroof\', \'Quattro All-Wheel Drive\', \'Fine Nappa Leather with Diamond Quilting\', \'Matrix LED Headlights\']\n  },\n  {\n    id: \'toyota-hilux-legend-2022\',\n    yr: 2022,\n    make: \'Toyota\',\n    name: \'Hilux 2.8 GD-6 Legend\',\n    variant: \'RS 4x4 Double Cab\',\n    body: \'Bakkie\',\n    perf: false,\n    km: 52000,\n    tr: \'Auto\',\n    fuel: \'Diesel\',\n    price: 619900,\n    tag: \'Legend RS Pack\',\n    hot: false,\n    img: \'https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=1000&q=80\',\n    gallery: [\n      \'https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=1000&q=80\',\n      \'https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=