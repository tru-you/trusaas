          text: "        <MessageCircle className=\"w-7 h-7 fill-white\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <span className=\"absolute -top-1 -right-1 bg-accent-crimson w-3.5 h-3.5 rounded-full border border-white\"></span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      </a>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      {/* Bottom Mockup note notification ribbon */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      <div className=\"fixed bottom-6 left-6 z-40 bg-ink/90 border border-white/10 backdrop-blur-md rounded-full px-4 py-2 font-mono text-[9px] text-gray-400 tracking-wider uppercase flex items-center gap-1.5 shadow-xl select-none\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <span className=\"w-2 h-2 bg-accent-crimson rounded-full\"></span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Interactive Design Mockup"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      {/* Modal detail render */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      {selectedVehicle && ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <VehicleModal "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
