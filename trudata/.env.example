# ==============================================================================
# TRUDATA PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- 1. SERVER CONFIGURATION ---
PORT=3001
NODE_ENV=development
LOCAL_MODE=1

# --- 2. BRIGHT DATA SCRAPING & SERP APIS ---
# Powers live Cars.co.za / AutoTrader / Property24 / Private Property unlocker
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_UNLOCKER_ZONE=unlocker_zone_name_here
SERP_API_KEY=your_brightdata_serp_key_here
SERP_ZONE=serp_zone_name_here
SERP_PROVIDER=brightdata

# --- 3. TRANSUNION / IMAGIN8 (SOUTH AFRICA VEHICLE BUREAU) ---
# Official TransUnion eValue8 credentials for M&M Book Values, SAPS Stolen Check, & Claims
IMAGIN8_API_KEY=your_imagin8_api_key_here
IMAGIN8_CUSTOMER_ID=your_imagin8_customer_id_here
IMAGIN8_USERNAME=your_imagin8_username_here
IMAGIN8_PASSWORD=your_imagin8_password_here
IMAGIN8_APP_NAME=Flow

# --- 5. PAYFAST GATEWAY (PAYMENT & CHECKOUT) ---
# Get your credentials at https://www.payfast.co.za/
# Set PAYFAST_SANDBOX=true for testing without real cards
PAYFAST_MERCHANT_ID=YOUR_MERCHANT_ID
PAYFAST_MERCHANT_KEY=YOUR_MERCHANT_KEY
PAYFAST_PASSPHRASE=YOUR_PASSPHRASE
PAYFAST_SANDBOX=true

# --- 6. EMAIL DISPATCH (SAMPLE PACKS & CSV DELIVERY) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_smtp_password
FROM_EMAIL=intelligence@tru-saas.com

# --- 7. FIREBASE ADMIN (OPTIONAL PERSISTENCE) ---
# Optional: falls back gracefully to in-memory/JSON if unset during local testing
GOOGLE_APPLICATION_CREDENTIALS=

SERPER_API_KEY=
