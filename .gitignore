# Dependencies & builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-www/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Secrets — never commit real env files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Host clutter / local data
.vercel
.railway
.fly
data/local-inventory.json
**/data/local-inventory.json

# OS / editor
.idea/
.vscode/
*.swp

# Local AI tooling
.claude/

# Deploy artifacts — rebuilt from the case-site source on every release,
# so committing them just bloats the repo with duplicate copies of the sites.
case-sites/_deploy/
case-sites/*-DEPLOY.zip
**/*.zip

# Archive masters — full-resolution splash video / artwork sources. Kept
# locally; the sites ship the compressed splash-*.mp4 / *-small.mp4 variants.
case-sites/_masters/
**/SPLASH VIDEO.mp4

# Editor backups / stray downloads at the repo root
*.backup.html
index.old-hub.backup.html

# Client commercial documents — proposals carry pricing and contact details
# for named dealers. Kept out of the repo; they live locally only.
Proposals/


# Runtime auth store — hashed access codes, generated per instance. Never commit.
**/auth.json

# Marketing-site Netlify drop
_deploy/
