# TruFlow Premium — production / local
NODE_ENV=development
PORT=3001

# Optional AI (falls back if empty)
DEEPSEEK_API_KEY=

# Firebase (same project as TruLens) — optional for pilot file mode
FIREBASE_PROJECT_ID=gen-lang-client-0151924955
AUTOLENS_DB_ID=ai-studio-autolenspro-7d4757ec-a059-4566-98db-d15a4840f4ec

# DocHub accounting integrations (Codat) — optional, only needed when a
# dealer enables Xero/QuickBooks/Zoho connect. Without a key, DocHub's
# 'connect' mode falls back to CSV export only.
CODAT_API_KEY=
CODAT_WEBHOOK_SECRET=

# Imagin8 / TransUnion eValue8. TWO credentials, both required — sent in the
# POST body as APIKey + customerId.
#   Makes / Models / Static Info → flat unlimited subscription (platform key).
#   Values / Reg Check → per-call (dealer pays); fall back to these if the
#   dealer hasn't set their own key + customerId in settings.
IMAGIN8_API_KEY=
IMAGIN8_CUSTOMER_ID=

# Send engine — email via SMTP (Resend, SendGrid, or any SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Send engine — SMS via HTTP gateway (BulkSMS, Clickatell, or similar)
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
