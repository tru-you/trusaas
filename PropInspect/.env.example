# TruEstate PMS — production / local
NODE_ENV=development
PORT=3001

# Optional AI (DeepSeek)
DEEPSEEK_API_KEY=

# Firebase project
FIREBASE_PROJECT_ID=gen-lang-client-0151924955

# Access codes (printed to log on first boot, optional to set via env)
# ADMIN_ACCESS_CODE=
# DEALER_CODE_D1=
# DEALER_CODE_D2=

# TruFlow sync (for cross-product code verification)
# TRUFLOW_SYNC_KEY=

# Shared DMS URL for TruProperty sync
# TRUFLOW_DMS_URL=

# FlowPMS — the master code authority. Codes + slugs live here; this app
# verifies access codes against it and mirrors agencies locally. Without
# FLOWPMS_URL (alias: TRUFLOW_DMS_URL) + a matching sync key, Flow-issued
# codes are refused here and only local accounts work.
# FLOWPMS_URL=http://localhost:3001
# FLOWPMS_SYNC_KEY=
